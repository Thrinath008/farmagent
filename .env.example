# Copy to .env in this folder (or to backend/.env) and fill in your own values.
# .env is git-ignored. Never commit it, and never put these values in the frontend.

ENVIRONMENT=development

# The frontend's address, for CORS. In development Vite proxies /api, so this rarely matters.
FRONTEND_URL=http://localhost:5173
# Comma-separated, for example a Vercel preview URL.
EXTRA_CORS_ORIGINS=

# PostgreSQL. A plain postgresql:// URL is fine, including Supabase's. On Render, use Supabase's
# session pooler URL: the direct connection is IPv6-only on Supabase's default plan.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmagent

# Claude. Without a key, the assistant says it is not connected and the other pages keep working.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenWeatherMap. Without a key, FarmAgent shows no weather and gives no weather-dependent advice.
# It never substitutes simulated data. New keys can take a few hours to activate.
OPENWEATHER_API_KEY=

# Set to true behind a proxy that sets X-Forwarded-For, such as Render. Leave false otherwise, or a
# client can dodge rate limits by sending that header itself.
TRUST_PROXY_HEADERS=false

# Optional. These are the defaults.
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_RETRIES=2
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_ADAPTIVE_THINKING=false
# AGENT_MAX_ITERATIONS=6
# AGENT_MAX_TOOL_CALLS=8
# AGENT_TOTAL_TIMEOUT_SECONDS=150
# AGENT_HISTORY_MESSAGES=20
# AGENT_MAX_MESSAGE_CHARS=4000
# OPENWEATHER_TIMEOUT_SECONDS=10
# OPENWEATHER_MAX_RETRIES=2
# OPENWEATHER_RETRY_BACKOFF_SECONDS=0.4
# WEATHER_CURRENT_TTL_SECONDS=600
# WEATHER_FORECAST_TTL_SECONDS=1800
# WEATHER_STALE_AFTER_SECONDS=10800
# WEATHER_CACHE_MAX_AGE_SECONDS=21600
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_PER_MINUTE=120
# RATE_LIMIT_AGENT_PER_MINUTE=12
# RATE_LIMIT_SESSION_PER_MINUTE=10
